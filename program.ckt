circ Baz {
    -> a[2];
    <- q[2];

    a -> q;
}

circ Foo {
    -> a[2];
    <- q[2];

    with Baz baz;

    a[0] -> baz.a[0];
    a[1] -> baz.a[1];
    baz.q[0..] -> q[0..];
}

circ Main {
    -> a;
    <- b;

    with Foo test[2], test2;
    a -> test[0].a[0];
    test[0].q -> test[1].a;
    test[1].q[1] -> test2.a[0];
    test2.q[0] -> b;
}
